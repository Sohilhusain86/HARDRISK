{
  "crons": [
    {
      "path": "/api/cron-notify?slot=morning",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron-notify?slot=afternoon",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron-notify?slot=evening",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron-notify?slot=night",
      "schedule": "0 16 * * *"
    }
  ]
}
