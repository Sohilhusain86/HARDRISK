/* ============================================================
   03 — HTML ESCAPING
   Prevent message text from becoming executable HTML.
   ============================================================ */
function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, character => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  }[character]));
}
