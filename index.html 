/* ============================================================
   25 — SEARCH EVENTS
   ============================================================ */
function initializeSearch() {
  const search = UI.one("#chatSearch");
  if (!search) {
    return;
  }
  search.addEventListener("input", event => {
    AppState.query = event.target.value;
    renderChats();
  });
}
/* ============================================================
   26 — MESSAGE INPUT
   ============================================================ */
function initializeMessageInput() {
  const input = UI.one("#messageInput");
  if (!input) {
    return;
  }
  input.addEventListener("keydown", event => {
    if (event.key === "Enter") {
      event.preventDefault();
      sendMessage();
    }
  });
}
/* ============================================================
   27 — KEYBOARD ACCESSIBILITY
   ============================================================ */
function initializeChatKeyboardAccess() {
  document.addEventListener("keydown", event => {
    const item = event.target.closest(".chat-item");
    if (
      item &&
      (event.key === "Enter" || event.key === " ")
    ) {
      event.preventDefault();
      openChat(item.dataset.chatId);
    }
    if (event.key === "Escape") {
      closeModal();
      closePanel();
    }
  });
}
/* ============================================================
   28 — APPLICATION INITIALIZATION
   ============================================================ */
function initializeApp() {
  renderChats();
  initializeOtpInputs();
  initializeSearch();
  initializeMessageInput();
  initializeChatKeyboardAccess();
}
if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", initializeApp);
} else {
  initializeApp();
}
</script>
