        break;
      case "emoji":
        openEmojiPicker();
        break;
      case "camera":
        openCameraNotice();
        break;
      case "close-modal":
        closeModal();
        break;
      case "edit-profile":
        openEditProfile();
        break;
      default:
        break;
    }
  }
  const chatItem = event.target.closest(".chat-item");
  if (chatItem) {
    openChat(chatItem.dataset.chatId);
  }
  const filter = event.target.closest(".filter");
  if (filter) {
    UI.all(".filter").forEach(button => {
      button.classList.remove("active");
    });
    filter.classList.add("active");
    AppState.filter = filter.dataset.filter;
    renderChats();
  }
  const messageElement = event.target.closest(".message-row");
  if (messageElement && AppState.activeChatId) {
    beginReply(messageElement.dataset.messageId);
