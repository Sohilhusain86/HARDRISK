/* ============================================================
   09 — SEND MESSAGE UI
   This updates only the local UI state.
   Real database delivery belongs to Messaging phase.
   ============================================================ */
function sendMessage() {
  const input = UI.one("#messageInput");
  if (!input) {
    return;
  }
  const text = input.value.trim();
  if (!text || !AppState.activeChatId) {
    return;
  }
  const chat = AppState.chats.find(
    item => item.id === AppState.activeChatId
  );
  if (!chat) {
    return;
  }
  const now = new Date().toLocaleTimeString([], {
    hour: "2-digit",
    minute: "2-digit"
  });
  chat.messages.push({
    id: Date.now(),
    dir: "out",
    text,
    time: now,
    status: "sent"
  });
  chat.preview = text;
  chat.time = now;
  input.value = "";
  AppState.replyingTo = null;
  UI.one("#replyBar").hidden = true;
  renderMessages(chat);
  renderChats();
}
