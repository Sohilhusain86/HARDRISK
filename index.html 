function beginReply(messageId) {
  const chat = AppState.chats.find(
    item => item.id === AppState.activeChatId
  );
  if (!chat) {
    return;
  }
  const message = chat.messages.find(
    item => String(item.id) === String(messageId)
  );
  if (!message) {
    return;
  }
  AppState.replyingTo = message;
  UI.one("#replyText").textContent = message.text;
  UI.one("#replyBar").hidden = false;
  UI.one("#messageInput")?.focus();
}
function cancelReply() {
  AppState.replyingTo = null;
  UI.one("#replyBar").hidden = true;
}
