        <span>›</span>
      </div>
      <div class="setting-row">
        <span>Clear chat</span>
        <span>›</span>
      </div>
    `
  );
}
function openChatSearch() {
  openModal(
    "Search in chat",
    `
      <input
        type="search"
        style="width:100%;padding:12px;border:1px solid var(--color-border);border-radius:8px"
        placeholder="Search messages"
        aria-label="Search messages"
