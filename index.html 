   ============================================================ */
function chatMatchesFilter(chat) {
  if (AppState.filter === "unread") {
    return chat.unread > 0;
  }
  if (AppState.filter === "groups") {
    return chat.group === true;
  }
  if (AppState.filter === "favorites") {
    return chat.favorite === true;
  }
  return true;
}
function chatMatchesSearch(chat) {
  const query = AppState.query.trim().toLowerCase();
  if (!query) {
    return true;
  }
  return (
    chat.name.toLowerCase().includes(query) ||
    chat.preview.toLowerCase().includes(query)
  );
}
/* ============================================================
   06 — CHAT LIST RENDERING
   ============================================================ */
function renderChats() {
  const list = UI.one("#chatList");
  if (!list) {
    return;
  }
  const visibleChats = AppState.chats.filter(chat => (
    chatMatchesFilter(chat) &&
    chatMatchesSearch(chat)
  ));
  if (!visibleChats.length) {
    list.innerHTML = `
      <div class="empty-chat" style="padding:50px 20px">
        <h3>No chats found</h3>
        <p>Try another search or filter.</p>
      </div>
    `;
    return;
  }
  list.innerHTML = visibleChats.map(chat => `
    <article
      class="chat-item ${chat.id === AppState.activeChatId ? "active" : ""}"
      data-chat-id="${escapeHTML(chat.id)}"
      role="listitem"
      tabindex="0"
