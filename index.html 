function handleLoginContinue() {
  const phoneInput = UI.one("#phoneNumber");
  const error = UI.one("#loginError");
  if (!phoneInput || !error) {
    return;
  }
  const phone = phoneInput.value.trim();
  const digits = phone.replace(/\D/g, "");
  if (digits.length < 7) {
    error.hidden = false;
    error.textContent = "Please enter a valid mobile number.";
    return;
  }
  error.hidden = true;
  const country = UI.one("#countryCode").value;
  UI.one("#otpDescription").textContent =
    `Enter the verification code for ${country} ${phone}.`;
  showScreen("otpScreen");
  window.setTimeout(() => {
    UI.one(".otp-input")?.focus();
  }, 50);
}
/* ============================================================
   19 — OTP INPUT NAVIGATION
   ============================================================ */
function initializeOtpInputs() {
  const inputs = UI.all(".otp-input");
  inputs.forEach((input, index) => {
    input.addEventListener("input", () => {
      input.value = input.value
        .replace(/\D/g, "")
        .slice(0, 1);
      if (input.value && inputs[index + 1]) {
        inputs[index + 1].focus();
      }
    });
    input.addEventListener("keydown", event => {
      if (
        event.key === "Backspace" &&
        !input.value &&
        inputs[index - 1]
      ) {
        inputs[index - 1].focus();
      }
    });
  });
}
