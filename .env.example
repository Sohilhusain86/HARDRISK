# Firebase Admin SDK (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com

# Authentication / sessions
JWT_SECRET=replace-with-a-long-random-secret

# AI providers (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_KEY=
SUHAIL_PLUS_MODEL=openai/gpt-oss-20b
SUHAIL_PRO_MODEL=openai/gpt-oss-120b

# Payment display / manual verification
# Put your real FamPay/UPI QR image at public/payment-qr.png OR set a public URL here.
PAYMENT_UPI_ID=
PAYMENT_QR_URL=/payment-qr.png
PAYMENT_NAME=SUHAIL AI

# Admin
ADMIN_EMAIL_PUBLIC=
APP_NAME=SUHAIL AI
